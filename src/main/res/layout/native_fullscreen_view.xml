<?xml version="1.0" encoding="utf-8"?>
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gnt_outline_shape">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
            android:id="@+id/media_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!--
          Lớp phủ tối ở đáy. MediaView ở template này phủ kín cả view, nên tiêu đề và body bị vẽ
          thẳng lên ảnh quảng cáo — ảnh sáng hoặc nhiều chi tiết là chữ lẫn hết vào nền.

          Khai NGAY SAU media_view và TRƯỚC các view chữ: thứ tự khai quyết định thứ tự vẽ, nên nó
          nằm trên ảnh mà vẫn dưới chữ.
        -->
        <View
            android:id="@+id/bottom_scrim"
            android:layout_width="0dp"
            android:layout_height="@dimen/size200"
            android:background="@drawable/gradient_bottom_dark"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cta"
            android:layout_width="0dp"
            android:layout_height="@dimen/size56"
            android:layout_marginHorizontal="@dimen/size10"
            android:layout_marginBottom="@dimen/size20"
            android:background="@drawable/shape_cta_native_admob"
            android:gravity="center"
            android:lines="1"
            android:textColor="@color/gnt_white"
            android:textSize="@dimen/size14"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_min="@dimen/size40"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/size55"
            android:layout_height="@dimen/size55"
            android:layout_marginStart="@dimen/d_10dp"
            android:layout_marginEnd="@dimen/size10"
            android:layout_marginBottom="@dimen/size10"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="@+id/cta"
            app:layout_constraintBottom_toTopOf="@+id/cta"
            app:layout_constraintStart_toStartOf="parent"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/d_10dp"
            android:layout_marginBottom="@dimen/size10"
            android:ellipsize="end"
            android:maxLines="3"
            android:textColor="@color/ads_fullscreen_body"
            android:textSize="@dimen/size12"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@+id/cta"
            app:layout_constraintEnd_toEndOf="@+id/cta"
            app:layout_constraintStart_toEndOf="@+id/icon"
            tools:text="@tools:sample/lorem/random" />

        <TextView
            android:id="@+id/primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/d_10dp"
            android:layout_marginBottom="@dimen/size5"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/ads_fullscreen_title"
            android:textSize="@dimen/size17"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@+id/body"
            app:layout_constraintEnd_toEndOf="@+id/cta"
            app:layout_constraintStart_toEndOf="@+id/icon"
            tools:text="Nhận học bổng du học Mỹ" />

        <!-- Declared LAST so the required "Ad" label is drawn on TOP of the MediaView
             (which fills the whole view). When it came first the media covered it. -->
        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/tvAdView"
            android:layout_width="@dimen/size30"
            android:layout_height="@dimen/size20"
            android:layout_marginTop="@dimen/size24"
            android:background="@drawable/shape_ad_view_3"
            android:gravity="center"
            android:text="Ad"
            android:textColor="@color/gnt_white"
            android:textSize="@dimen/size12"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>