<?xml version="1.0" encoding="utf-8"?>
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/gnt_outline_shape">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cta"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size40"
            android:layout_marginHorizontal="@dimen/size12"
            android:layout_marginTop="@dimen/size2"
            android:background="@drawable/shape_cta_native_admob"
            android:gravity="center"
            android:lines="1"
            android:textColor="@color/gnt_white"
            android:textSize="@dimen/size14"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_min="@dimen/size40"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/appCompatTextView3" />


        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/appCompatTextView3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/shape_ad_view"
            android:paddingHorizontal="@dimen/size5"
            android:text="Ad"
            android:textColor="@color/gnt_white"
            android:textSize="11sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
            android:id="@+id/media_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size128"
            android:layout_marginTop="@dimen/size5"
            android:layout_marginBottom="@dimen/size2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cta" />

        <!--
          Chiều cao phải bằng icon bên trong (55dp). Trước đây để 50dp nên icon và body tràn ra
          ngoài biên NativeAdView, AdMob native ad validator báo "Advertiser assets outside native
          ad view" — vi phạm chính sách, mà cảnh báo đó chỉ hiện trên test device nên rất dễ lọt.
        -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/middle"
            android:layout_width="0dp"
            android:layout_height="@dimen/size55"
            android:layout_marginBottom="@dimen/size2"
            android:layout_marginHorizontal="@dimen/size12"
            android:layout_marginTop="@dimen/size5"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/media_view">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="@dimen/size55"
                android:layout_height="@dimen/size55"
                android:scaleType="fitCenter"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@tools:sample/avatars" />

            <TextView
                android:id="@+id/primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size8"
                android:layout_marginEnd="@dimen/size5"
                android:ellipsize="end"
                android:lines="1"
                android:textColor="@color/text_color_cta"
                android:textSize="@dimen/size15"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/icon"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Nhận học bổng du học Mỹ" />

            <!-- Card nền sáng: chữ trắng gần như không đọc được. Dùng cùng màu body với
                 native_cta_bottom_view. -->
            <TextView
                android:id="@+id/body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/size8"
                android:maxLines="2"
                android:textColor="@color/text_color_second"
                android:textSize="@dimen/size12"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/icon"
                app:layout_constraintTop_toBottomOf="@+id/primary" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>

