<?xml version="1.0" encoding="utf-8"?>
<!-- Template native gọn cho Home: media bên trái, text + CTA bên phải.
     Cao ~140dp (media 120dp + margin), thay cho template list dọc ~250dp.
     Media KHÔNG được nhỏ hơn 120x120dp: dưới ngưỡng đó AdMob không serve creative video vào slot
     này (validator báo "MediaView is too small for video") nên mất phần inventory đó. -->
<com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/native_ad_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/gnt_outline">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.libraries.ads.mobile.sdk.nativead.MediaView
            android:id="@+id/media_view"
            android:layout_width="@dimen/size120"
            android:layout_height="@dimen/size120"
            android:layout_margin="@dimen/size10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/ad_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size10"
            android:background="@drawable/shape_ad_badge_rounded"
            android:paddingHorizontal="@dimen/size5"
            android:text="Ad"
            android:textColor="@color/gnt_white"
            android:textSize="@dimen/size10"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintStart_toEndOf="@+id/media_view"
            app:layout_constraintTop_toTopOf="@+id/icon" />

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/size18"
            android:layout_height="@dimen/size18"
            android:layout_marginStart="@dimen/size6"
            android:scaleType="fitCenter"
            app:layout_constraintStart_toEndOf="@+id/ad_badge"
            app:layout_constraintTop_toTopOf="@+id/media_view"
            tools:src="@tools:sample/avatars" />

        <TextView
            android:id="@+id/primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size6"
            android:layout_marginEnd="@dimen/size10"
            android:ellipsize="end"
            android:lines="1"
            android:textColor="@color/text_color_cta_2"
            android:textSize="@dimen/size14"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/icon"
            app:layout_constraintTop_toTopOf="@+id/icon"
            tools:text="Nhận học bổng du học Mỹ" />

        <TextView
            android:id="@+id/body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/size10"
            android:layout_marginTop="@dimen/size4"
            android:layout_marginEnd="@dimen/size10"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/gnt_gray"
            android:textSize="@dimen/size11"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toTopOf="@+id/cta"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/media_view"
            app:layout_constraintTop_toBottomOf="@+id/icon"
            app:layout_constraintVertical_bias="0"
            tools:text="@tools:sample/lorem/random" />

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/cta"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/size40"
            android:layout_marginEnd="@dimen/size10"
            android:background="@drawable/shape_cta_native_admob"
            android:gravity="center"
            android:lines="1"
            android:minWidth="@dimen/size88"
            android:paddingHorizontal="@dimen/size12"
            android:textColor="@color/gnt_white"
            android:textSize="@dimen/size16"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/media_view"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="Cài đặt" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.libraries.ads.mobile.sdk.nativead.NativeAdView>
